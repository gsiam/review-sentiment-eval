flowchart LR
    subgraph "Test data"
        direction TB
        N[Normal reviews]
        A[Adversarial reviews<br/>clean text + injection template]
        J[Judge calibration cases<br/>source + pre-written summary]
    end

    subgraph SUT["System under test: review analysis"]
        direction TB
        P[Prompt + task rules]
        M[Summarizer<br/>selected LLM]
        O[Structured output<br/>summary + sentiment + conflict flag]
        P --> M --> O
    end

    subgraph "Evaluation checks"
        direction TB
        F[Faithfulness<br/>summary vs source review]
        S[Sentiment accuracy<br/>if expected_sentiment exists]
        C[Conflict accuracy<br/>if expected_conflicting exists]
        R[Injection robustness<br/>baseline vs injected sentiment]
    end

    subgraph "Model endpoints"
        direction TB
        API[Provider API<br/>or Ollama]
        RAGAS[Ragas<br/>judge wrapper]
    end

    N --> P
    A --> P
    J --> F

    O --> F
    O --> S
    O --> C
    O --> R
    M --> API
    RAGAS --> API
    F --> RAGAS
